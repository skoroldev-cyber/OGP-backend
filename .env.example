# One Global People — backend environment.
# Secrets live in the host secret store. This file documents the shape; it never carries real values.

NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# --- Database -------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=ogp

# --- Identity -------------------------------------------------------------
# HMAC key for anonymous reader session tokens. Rotatable with a dual-key grace window:
# put the retiring key in SESSION_TOKEN_SECRET_PREVIOUS during the window.
SESSION_TOKEN_SECRET=change-me-32-bytes-minimum-please-rotate
SESSION_TOKEN_SECRET_PREVIOUS=
ADMIN_JWT_SECRET=change-me-32-bytes-minimum-please-rotate
RECEIPT_SIGNING_SECRET=change-me-32-bytes-minimum-please-rotate

# Interim operations sign-in (development only). Refused when NODE_ENV=production.
# The only place the pair is defined; the panel mirrors nothing and just sends what you type.
# Quote the password — an unquoted `#` starts a comment and silently truncates the value.
ADMIN_DEV_LOGIN=true
ADMIN_DEV_NAME=admin
ADMIN_DEV_PASSWORD="OGP2468#"

# --- Origins --------------------------------------------------------------
PUBLIC_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
CDN_BASE_URL=

# --- Payments (NMI gateway, Payarc merchant account via PaymentCloud) -----
# NMI_SECURITY_KEY is the private Payment API key. It must never reach the browser.
NMI_SECURITY_KEY=
NMI_COLLECT_JS_KEY=
NMI_WEBHOOK_SIGNING_KEY=
NMI_API_URL=https://secure.nmi.com/api/transact.php

# --- Mail -----------------------------------------------------------------
# EMAIL_TRANSPORT: log | smtp
#   log  = write the message to the structured log; do not deliver
#   smtp = send for real using SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_PASS
EMAIL_TRANSPORT=log
# The address a Founding Reader sees and replies to (the From: line).
EMAIL_FROM=va@oneglobalpeople.org
# Mail server connection. Leave SMTP_HOST empty while EMAIL_TRANSPORT is log.
# SMTP_PORT=465 uses TLS from the first byte. SMTP_PORT=587 upgrades with STARTTLS.
# SMTP_USER is the full mailbox address. SMTP_PASS is the mailbox password.
#
# SMTP_PASS is deliberately empty in this file and must stay empty. This file is the shared
# template — it is committed, read by everyone with the repository, and copied by every
# operator setting the API up. A credential written here is a credential published. Put the
# real one in your own .env, which is not shared.
#
# For Gmail this is an App Password, not the account password, and it is generated per
# application at https://myaccount.google.com/apppasswords. If one is ever pasted here by
# accident, revoke it on that page rather than deleting the line — the value has already been
# read by then, and a revoked password costs nothing to replace.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=va@oneglobalpeople.org
SMTP_PASS=

# Envelope sender, when the relay requires a verified address that differs from EMAIL_FROM.
# Empty means "use EMAIL_FROM".
SMTP_FROM=
# Reader-facing origin written into invitation mail. The Opening Arc path is not appended.
INVITE_PATH=/

# --- Feature flags --------------------------------------------------------
# Phase 1B age calibration. Only `full_manuscript` is certified today, so this ships OFF.
AGE_LAYER_ENABLED=false
# Free digital-transcript path. Founder switch.
FREE_ACCESS_ENABLED=false
# Hardcover purchase flow. Requires products.priceCents to be set by the founder.
HARDCOVER_PURCHASABLE=false
# Regulated sharing windows. The server still gates every individual prompt.
SHARING_ENABLED=true

# --- Scale ----------------------------------------------------------------
# Empty = in-memory rate limiter and event buffer (single node).
RATE_LIMIT_REDIS_URL=
EVENT_FLUSH_INTERVAL_MS=2000
EVENT_FLUSH_MAX_BATCH=500
