{
  "name": "ogp-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "One Global People — anonymous session, canonical manuscript delivery, event ingestion, regulated sharing, Founding Reader beta, and NMI commerce.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "eslint .",
    "test": "node --test \"test/**/*.test.js\"",
    "check:prohibited-data": "node --test test/prohibited-data.test.js",
    "ingest:manuscript": "node scripts/ingest-manuscript.mjs",
    "db:indexes": "node scripts/ensure-indexes.mjs",
    "db:seed": "node scripts/seed.mjs",
    "admin:create": "node scripts/create-admin.mjs",
    "verify": "npm run lint && npm test"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.1",
    "mongodb": "^6.20.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "pino-pretty": "^13.1.2"
  }
}
